{
  "name": "kemz-next-payload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx,.js,.mjs src scripts next.config.mjs",
    "check:release-env": "node scripts/check-release-env.mjs",
    "test:cms": "node --import tsx scripts/smoke-cms.ts",
    "verify:cms": "node --env-file=.env.local --import tsx scripts/verify-imported-cms.mjs",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@phosphor-icons/react": "2.1.10",
    "graphql": "16.11.0",
    "next": "16.3.8",
    "nodemailer": "10.0.10",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.105.1",
    "sharp": "0.35.5",
    "zod": "4.4.3"
  },
  "overrides": {
    "undici": "7.29.1",
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "8.71.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  }
}
