# Use a separate LOCAL or STAGING PostgreSQL database, never production.
# Do not commit real values. Names only — see DEPLOY.md.
DATABASE_URL=postgresql://kemz:password@127.0.0.1:5432/kemz_migration
PAYLOAD_SECRET=

# Public origin of this Next preview/staging process (not production Nuxt DNS by default).
PUBLIC_SITE_URL=http://127.0.0.1:3100
# Indexing unlock requires BOTH true and PUBLIC_SITE_URL=https://aokemz.ru
SITE_INDEXABLE=false
# Allow http://127.0.0.1:3100 Origin on form POSTs when NODE_ENV=production locally.
ALLOW_LOCAL_PREVIEW=true
# Set true only when the reverse proxy strips/replaces incoming X-Forwarded-For.
TRUST_PROXY=false

# Optional: without these, development uploads stay in .data/media.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMTP for Payload CMS mail and /api/sendMail (leave empty until configured).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Prefer an explicit staging inbox; default in code is production sales if unset.
MAIL_TO=

# Private read-only API access; never NEXT_PUBLIC and never commit a token.
YANDEX_METRIKA_COUNTER_ID=113528354
YANDEX_METRIKA_TOKEN=
